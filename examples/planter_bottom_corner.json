    "chan_x_len": "corner_size_x - outer_wall_thick",
    "chan_x_cx": "outer_wall_thick + chan_x_len / 2",
    "chan_x_cy": "outer_wall_thick + channel_width / 2",
    "chan_y_len": "corner_size_y - outer_wall_thick",
