    "chan_y_cy": "outer_wall_thick + chan_y_len / 2",
    "rib_thick": "2.7 mm",
    "rib_gap": "27.7 mm",
    "rib_pitch": "rib_gap + rib_thick",
    "rib_count_y": "3",
    "rib_count_x": "3",
    "rib_start_y": "45 mm",
    "rib_start_x": "45 mm",
    "foot_pos_x": "58 mm",
    "foot_pos_y": "58 mm",
    "foot_dia": "22 mm",
    "foot_height": "12 mm",
    "slot_width": "6 mm",
    "slot_len": "10 mm",
    "slot_pos_y": "58 mm",
    "slot_height": "10 mm"
  },
  "timeline": [
    {
