          "height": "corner_size_y"
        }
      ]
    },
    {
      "op": "extrude",
      "id": "main_block",
      "sketch": "block_sk",
      "distance": "rim_height",
      "mode": "new_body"
    },
    {
      "op": "sketch",
      "id": "floor_recess_sk",
      "plane": "xy",
