# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.manifest text eol=lf

# Not needed to run the add-in: left out of the release zip (built with git archive)
.github/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
CONTRIBUTING.md export-ignore
test_dsl.py export-ignore
sample.json export-ignore
settings.example.json export-ignore
examples/ export-ignore
docs/ export-ignore
*.gif binary
